ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
MESHY_API_KEY=
# Reserved for a future provider — not implemented yet. Leave MODEL_GENERATION_PROVIDER=meshy.
TRIPO_API_KEY=
MODEL_GENERATION_PROVIDER=meshy

# Unused until the ForgeAIBridge Unreal plugin (Phase 4) exists.
UNREAL_BRIDGE_TOKEN=
UNREAL_BRIDGE_WS_URL=ws://127.0.0.1:8080/forge

# Only meaningful if this machine also runs `npm run dev` — Vercel deployments
# have no local Unreal install to launch. Set to auto-open Unreal Editor and
# import each finished GLB. Leave unset to skip this entirely.
UNREAL_PROJECT_PATH=C:/Path/To/YourProject/YourProject.uproject
UNREAL_CONTENT_ROOT=/Game/ForgeAI
# Optional override if UnrealEditor.exe isn't under the standard Epic Games
# Launcher install path for the .uproject's EngineAssociation version.
UNREAL_EDITOR_EXE=

DATABASE_URL=postgresql://forge:forge@localhost:5432/forge_ai

ASSET_STORAGE_DRIVER=local
ASSET_STORAGE_PATH=./storage
# Required when ASSET_STORAGE_DRIVER=blob — needed in production, since Vercel
# Functions have no shared local filesystem. Get this from `vercel env pull`
# after provisioning a Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Not implemented yet — do not set ASSET_STORAGE_DRIVER=s3. Reserved for a
# future adapter.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
